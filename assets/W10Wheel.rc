// The resources of W10Wheel.exe. A template: build.rs replaces the @...@ values (the paths, and the
// version of Cargo.toml) and compiles it with rc.exe. Numbers instead of the names of winver.h
// (rc.exe is run without the include paths of the SDK).
// The tray icons (TrayIcon-Run.ico, TrayIcon-Stop.ico) are in the exe too, included as data
// (src/icons.rs): drawn at the size of each DPI from the frames of the files.

1 ICON "@APP_ICON@"
1 24 "@MANIFEST@"

1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEFLAGSMASK 0x3FL
FILEFLAGS @FILE_FLAGS@
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "Comments", "Mouse Wheel Simulator (Rust)"
            VALUE "FileDescription", "W10Wheel"
            VALUE "FileVersion", "@VERSION4@"
            VALUE "InternalName", "W10Wheel"
            VALUE "LegalCopyright", "Copyright (c) 2016 Yuki Ono"
            VALUE "OriginalFilename", "W10Wheel.exe"
            VALUE "ProductName", "W10Wheel"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
